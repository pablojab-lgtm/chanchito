rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }

    // Cada usuario solo ve su propio perfil (a qué grupo pertenece).
    match /users/{userId} {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }

    match /households/{hid} {
      function isMember() {
        return signedIn() && request.auth.uid in get(/databases/$(database)/documents/households/$(hid)).data.members;
      }

      allow create: if signedIn() && request.resource.data.members == [request.auth.uid];
      allow read: if signedIn() && request.auth.uid in resource.data.members;
      allow delete: if false;
      allow update: if signedIn() && (
        request.auth.uid in resource.data.members
        // Sumarse con el código (el id del grupo es largo y aleatorio: funciona como contraseña):
        // solo puede agregarse a sí mismo, sin tocar nada más.
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'memberNames'])
            && request.resource.data.members.hasAll(resource.data.members)
            && request.resource.data.members.size() == resource.data.members.size() + 1
            && request.auth.uid in request.resource.data.members)
      );

      match /{sub}/{docId} {
        allow read, write: if isMember();
      }
    }
  }
}
